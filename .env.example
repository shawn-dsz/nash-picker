# Nash sandbox. Copy to .env.local and fill in. Never commit .env.local.
#
# Get the key and org id from the Portal: https://portal.sandbox.usenash.com
#   Settings -> API keys. Sandbox keys are separate from production keys.
#
# Base URL - pick the region that matches the sandbox org.
#   Sandbox AU  https://api.sandbox.ap-southeast-2.usenash.com/v1
#   Sandbox US  https://api.sandbox.usenash.com/v1
# VERIFIED 2026-08-06: this sandbox org is US. The AU host returns
# MISSING_RESOURCE "API key not found", which reads as a bad key but is
# actually a wrong-region error. Probe before debugging auth.

NASH_API_KEY=
# Only needed when the key spans multiple orgs. Verified not required here.
NASH_ORG_ID=
NASH_API_BASE=https://api.sandbox.usenash.com/v1

# The store OnePick picks for. Needed to join order items to per-store
# inventory, which is where aisle/bay/shelf lives.
NASH_STORE_LOCATION_ID=

# Read only in server-side route handlers. Never prefix with NEXT_PUBLIC_ -
# that would ship the key in the browser bundle.
